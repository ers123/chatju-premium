# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Environment variables (IMPORTANT - Never commit secrets!)
# Cover every .env variant (.env.staging held live service keys and was NOT
# matched by the previous patterns), then allow example templates back in.
.env
.env.*
!.env.example
!.env.*.example
backend/.env
backend/.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
*.log
logs/

# Test coverage
coverage/

# Temporary files
*.tmp
.cache/

# Backup files
*.backup.js
*.v4.backup.js
*.bak

# AWS Lambda deployment
.aws-sam/
.serverless/

# Python (if used for tooling)
__pycache__/
*.py[cod]
*$py.class

# Supabase (local development)
.supabase/
backend/somyung-deploy_accessKeys.csv
.gstack/

# Local tooling / internal notes (not shipped)
.omx/
security-check-*.md
# 벤더링된 스킬 사본. .claude/ 와 같은 성격이라 같은 규칙으로 다룬다.
.agents/
# 브라우저 QA 산출물. 콘솔 로그·페이지 덤프에 더해 실제 리포트 PDF가 떨어진다 —
# 아이 이름·생년월일이 담길 수 있어 레포에 들어가면 안 된다.
.playwright-cli/

# 측정·생성 산출물 (재현 가능하므로 커밋하지 않는다)
# output/localization 은 eval-localization.js 가 만드는 리포트·판정 캐시로,
# 한 번 돌리면 수 MB가 쌓인다. localization_findings_*.md 가 결과를 요약한다.
output/
out-sandbox/
tmp/
